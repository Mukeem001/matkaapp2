# Matka Admin Panel - Environment Configuration

# API Server URL (Required)
# This is where the admin panel will send API requests
# Production: https://matka-api-server.onrender.com (without /api - it's added by generated paths)
VITE_API_URL=https://matka-api-server.onrender.com

# App title
VITE_APP_TITLE=Matka Admin Panel

# Feature flags (optional)
VITE_ENABLE_DEMO_MODE=false
VITE_DEBUG_MODE=false
