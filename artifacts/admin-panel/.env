# Matka Admin Panel - Environment Configuration

# Server Port
PORT=5173

# API Server Configuration
# For development (localhost): Use the local backend on port 3000
VITE_API_URL=http://localhost:3000

# For production, uncomment and set to your API server URL:
# VITE_API_URL=https://matka-api-server.onrender.com

# API Base URL for vite proxy (only used in vite.config.ts)
VITE_API_BASE_URL=http://localhost:3000

# App title
VITE_APP_TITLE=Matka Admin Panel

# Feature flags (optional)
VITE_ENABLE_DEMO_MODE=false
VITE_DEBUG_MODE=false
