{
    "extends":  "../../tsconfig.base.json",
    "compilerOptions":  {
                            "composite":  true,
                            "declarationMap":  true,
                            "emitDeclarationOnly":  true,
                            "outDir":  "dist",
                            "rootDir":  "src",
                            "skipLibCheck":  true,
                            "ignoreDeprecations": "5.4"
                        },
    "include":  [
                    "src"
                ]
}
